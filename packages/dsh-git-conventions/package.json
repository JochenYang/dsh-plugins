{
  "name": "dsh-git-conventions",
  "version": "0.1.0",
  "description": "Model-facing git convention validation tool bundle for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js --external:@deepseek-ai/*",
    "typecheck": "tsc --noEmit",
    "pack": "node scripts/pack.mjs",
    "prepack": "pnpm run build"
  }
}

