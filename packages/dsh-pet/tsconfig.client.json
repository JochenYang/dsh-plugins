{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": ".client-build",
    "rootDir": "src/client",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../../../deepseek-harness/vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/schemastery": ["../../../deepseek-harness/vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-api-session-controller/client": ["../../../deepseek-harness/packages/api/session-controller/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-session/types": ["../../../deepseek-harness/packages/core/session/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-client-ui-conversation/client": ["../../../deepseek-harness/packages/client/ui-conversation/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer/client": ["../../../deepseek-harness/packages/client/ui-renderer/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-layout/client": ["../../../deepseek-harness/packages/client/ui-layout/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings/client": ["../../../deepseek-harness/packages/client/ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["../../../deepseek-harness/packages/client/ui-slots/lib/types/index.d.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"]
    }
  },
  "include": ["src/client"]
}
